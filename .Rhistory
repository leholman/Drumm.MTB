par(mar=c(8.5, 6.1, 1.1, 6.1),xpd=TRUE)
barplot(its.c[,dim(its.c)[2]:1],las=2,cex.names=0.6,col=getPalette(dim(its.c)[1]),ylab="",border = NA,
