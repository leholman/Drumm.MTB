sedAVR <- rowMeans(its.dat[,match(metadata$LV[metadata$sample=="S"],colnames(its.dat))])
## class
its.c <-   as.matrix(minAbundance(CountTable(as.character(its.dia$Class),cbind(controls,sedAVR,waterAVR),output = "Abundance"),minAbun=0.01))
## class
